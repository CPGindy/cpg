<odoo>
    <record id="wizard_pool_payment_form" model="ir.ui.view">
        <field name="name">wizard_pool_payment_form</field>
        <field name="model">pool.payment</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="licensor_id"/>
                            <field name="advance_payment" invisible="advance_payment == 0"/>
                        </group>
                        <group>
                            <field name="journal_balance"/>
                        </group>
                    </group>
                        <field name="pool_payment_line_ids" nolabel="1" view_mode="list">
                            <list editable="bottom" create="false">
                                <field name="artist_id" readonly="true"/>
                                <field name="advance_payment" readonly="true"/>
                                <field name="sale_balance" readonly="true"/>
                                <field name="balance_to_pay" readonly="true" string="Subtotal"/>
                                <field name="pool_covered" readonly="true"/>
                                <field name="remaining_balance" readonly="true" string="Total"/>
                            </list>
                        </field>
                </sheet>
                <footer>
                    <button name="make_payment" string="Make Bill" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="wizard_pool_payment_tree" model="ir.ui.view">
        <field name="name">wizard_pool_payment_tree</field>
        <field name="model">pool.payment</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                            <field name="licensor_id"/>
                            <field name="advance_payment" column_invisible="True"/>
                            <field name="journal_balance"/>
            </list>
        </field>
    </record>
</odoo>
